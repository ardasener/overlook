{
  "name": "overlook",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "scripts": {
    "themes:fetch": "bun run scripts/fetch-base16-themes.ts",
    "fonts:fetch": "bun run scripts/fetch-nerd-fonts.ts",
    "provision": "bun run themes:fetch && bun run fonts:fetch",
    "dev": "bun run provision && vite",
    "build": "bun run provision && tsc && vite build",
    "preview": "vite preview",
    "check-types": "bun run provision && tsc --noEmit",
    "test": "bun run provision && vitest run",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xterm/addon-fit": "0.12.0-beta.5",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/headless": "6.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "tar": "^7.4.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
